# -----------------------------------------------------------------------------
# Partner API — Decentralized Esports VOD & Clip Network
# -----------------------------------------------------------------------------
CLIPS_API_BASE_URL=https://api.esports-vods.tv/v1
CLIPS_API_KEY=your_partner_api_key_here

# Comma-separated, no protocol, no spaces needed (they're trimmed either way).
# Read by BOTH lib/api.ts (server-side embed validation) and next.config.js
# (CSP frame-src) — keep this as the single source of truth for which hosts
# are trusted to serve clip embeds. Swap per staging/production environment.
# next.config.js reads this at BUILD time, so set it in your CI/host's
# build-time env vars, not just a runtime .env file.
ALLOWED_IFRAME_HOSTS=embed.esports-vods.tv,player.clip-network.com

# Canonical site URL — used for sitemap.xml, robots.txt, OG tags, JSON-LD
NEXT_PUBLIC_SITE_URL=https://www.indietrailerhub.com

# ISR revalidation window, in seconds, for catalog + clip pages
REVALIDATE_SECONDS=3600

# -----------------------------------------------------------------------------
# Esports Ad Network + analytics script tags. Left blank = ad slots render as
# reserved, empty containers (no layout shift) until you supply real tags.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_AD_NETWORK_SCRIPT_URL=
NEXT_PUBLIC_AD_NETWORK_SITE_ID=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
